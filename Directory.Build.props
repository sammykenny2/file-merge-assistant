<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Product identity. The installer, the release workflow and the in-app update check read these values. -->
  <PropertyGroup>
    <Version>0.3.0</Version>
    <Product>File Workbench</Product>
    <Company>sammykenny2</Company>
    <Authors>sammykenny2</Authors>
    <Copyright>Copyright (c) 2025-2026 sammykenny2</Copyright>
    <!-- GitHub repository (owner/name) whose public releases the update check reads. -->
    <UpdateRepository>sammykenny2/messy-file-workbench</UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
</Project>
