<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FileMergeAssistant.Tests</RootNamespace>
    <!-- Allow underscores in test method names (common convention) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Fixtures\analysis\known-answer.json" Link="Fixtures\analysis\known-answer.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\index\schema-v3.sql" Link="Fixtures\index\schema-v3.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\index\migration-v4.sql" Link="Fixtures\index\migration-v4.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
