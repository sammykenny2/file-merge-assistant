<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FileWorkbench.Cli.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cli/Cli.csproj" />
    <Compile Include="../Core.Tests/Analysis/KnownAnswerDataset.cs" Link="Fixtures/KnownAnswerDataset.cs" />
    <Compile Include="../Core.Tests/Scanning/TempTree.cs" Link="Fixtures/TempTree.cs" />
    <None Include="../Fixtures/analysis/known-answer.json" Link="Fixtures/analysis/known-answer.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/similar-images/*" Link="Fixtures/similar-images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
