{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "SendStreamingMessage",
  "params": {
    "message": {
      "messageId": "[message-id]",
      "role": "ROLE_USER",
      "parts": [
        {
          "text": "Investigate the current deployment issue and stream progress updates.",
          "mediaType": "text/plain"
        }
      ]
    },
    "configuration": {
      "acceptedOutputModes": [
        "text/plain",
        "application/json"
      ],
      "historyLength": 5
    }
  }
}
