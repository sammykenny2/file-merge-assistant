<UserControl x:Class="FileMergeAssistant.Gui.Workbench.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:FileMergeAssistant.Gui.Workbench"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance w:PlanViewModel}">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <Grid Margin="40,32,40,56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <!-- Nothing pending -->
      <StackPanel Grid.ColumnSpan="3" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="待執行" Style="{StaticResource H1}" />
        <TextBlock Text="還沒有待執行的疊。在工作台打開一疊，選好正本與做法後按「加入待執行」，它就會出現在這裡。加入待執行不會改動任何檔案。"
                   Style="{StaticResource Lead}" Margin="0,10,0,18" />
        <Button Content="回工作台" Style="{StaticResource PrimaryButton}" Command="{Binding GoToHubCommand}" />
      </StackPanel>

      <StackPanel Grid.Column="0" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" />
        <TextBlock Text="按下執行之前，什麼都不會改動。執行時會先再檢查每個檔的現況；決定之後有變動的項目會停下來，不會照舊計畫處理。"
                   Style="{StaticResource Lead}" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left" />

        <Border Background="{StaticResource StripBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,16,0,18"
                AutomationProperties.LiveSetting="Polite">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="重新檢查" Style="{StaticResource SmallButton}" Command="{Binding RecheckCommand}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{StaticResource Ink2Brush}">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconSync}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding CheckLine}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Stacks}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type w:PlanStackViewModel}">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <DockPanel Margin="18,14,18,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Content="回到這疊修改" Style="{StaticResource SmallButton}" Command="{Binding Edit}" Margin="0,0,8,0" />
                      <Button Content="移出待執行" Style="{StaticResource SmallButton}" Command="{Binding Remove}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                      <TextBlock Text="{Binding Decision}" Style="{StaticResource Small}" FontSize="13.5" />
                      <WrapPanel Margin="0,8,0,0">
                        <Border CornerRadius="10" Background="{StaticResource AccentBrush}" Padding="8,0,8,1" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="正本" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                          <Run Text="{Binding KeeperPrefix, Mode=OneWay}" Foreground="{StaticResource FaintBrush}" /><Run Text="{Binding KeeperTail, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                      </WrapPanel>
                      <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource AccentDarkBrush}" Margin="0,4,0,0"
                                  Visibility="{Binding KeeperCheck, Converter={StaticResource NullToVisibility}}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding KeeperCheck}" FontSize="12.5" />
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type w:PlanItemViewModel}">
                        <Border x:Name="row" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="18,10" Background="{StaticResource SurfaceBrush}">
                          <StackPanel>
                            <DockPanel>
                              <ContentControl DockPanel.Dock="Right" Content="{Binding Status}" Focusable="False" VerticalAlignment="Top" Margin="12,0,0,0" />
                              <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{Binding ToggleName}">
                                <StackPanel>
                                  <TextBlock TextWrapping="Wrap">
                                    <Run x:Name="verb" Text="{Binding Verb, Mode=OneWay}" FontWeight="Bold" /><Run Text="　" /><Run Text="{Binding Target, Mode=OneWay}" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" />
                                </StackPanel>
                              </CheckBox>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}" Margin="30,6,0,0"
                                        Visibility="{Binding DependencyWarning, Converter={StaticResource NullToVisibility}}">
                              <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,6,0" />
                              <TextBlock Text="{Binding DependencyWarning}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Margin="30,8,0,0" Padding="12,8" CornerRadius="6" Background="{StaticResource WarnSoftBrush}"
                                    Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}">
                              <StackPanel>
                                <TextBlock Text="{Binding ChangeDetail}" TextWrapping="Wrap" Foreground="{StaticResource WarnInkBrush}" />
                                <WrapPanel Margin="0,8,0,0">
                                  <Button Content="回到這疊重新比對" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                          Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                  <Button Content="{Binding SkipLabel}" Style="{StaticResource SmallButton}" Command="{Binding ToggleSkipCommand}" />
                                </WrapPanel>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsCopy}" Value="True">
                            <Setter TargetName="verb" Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsChanged}" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{StaticResource WarnPaleBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="row" Property="TextElement.Foreground" Value="{StaticResource FaintBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="18,10" Visibility="{Binding Foot, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource MutedBrush}">
                      <Path Style="{StaticResource Icon}" Data="{StaticResource IconOffline}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Foot}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Column="2" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
        <Border Style="{StaticResource Card}" Padding="18,14">
          <StackPanel>
            <TextBlock Text="空間" Style="{StaticResource H2}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding SpaceFigures}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type w:SpaceFigure}">
                  <StackPanel Margin="0,8,0,4">
                    <DockPanel>
                      <TextBlock x:Name="value" DockPanel.Dock="Right" Text="{Binding Value}" FontSize="18" FontWeight="Bold" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Faint}" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAccent}" Value="True">
                      <Setter TargetName="value" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="確認執行" Style="{StaticResource H2}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,6,0,0" />
            <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                    Visibility="{Binding HasStopped, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,6,0" VerticalAlignment="Top" />
                <TextBlock Text="有變動的項目這次不會執行；可以回到那疊重新比對，或選擇這次略過。" TextWrapping="Wrap" Width="290" FontSize="13" />
              </StackPanel>
            </Border>
            <StackPanel Margin="0,10,0,0">
              <TextBlock Text="• 會先完成複製並確認，再把複本移入回收區。" Style="{StaticResource Small}" FontSize="13" Margin="0,2" />
              <TextBlock Text="• 只執行上面勾選的項目。之後再加入的疊，要重新確認。" Style="{StaticResource Small}" FontSize="13" Margin="0,2" />
              <TextBlock Text="• 移入回收區的項目可以在歷史裡還原，不會永久刪除。" Style="{StaticResource Small}" FontSize="13" Margin="0,2" />
              <TextBlock Text="• 執行途中可以取消；已完成的項目會保留紀錄。" Style="{StaticResource Small}" FontSize="13" Margin="0,2" />
            </StackPanel>
            <Button Content="{Binding ExecuteLabel}" Style="{StaticResource PrimaryButton}" MinHeight="48" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                    Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanExecute}" />
            <TextBlock Text="執行中…" Style="{StaticResource Small}" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Border Background="{StaticResource StripBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                    Visibility="{Binding UnavailableReason, Converter={StaticResource NullToVisibility}}">
              <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource Small}" FontSize="13" />
            </Border>
            <Button Content="返回工作台" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Command="{Binding GoToHubCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
