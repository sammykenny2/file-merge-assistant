<UserControl x:Class="FileMergeAssistant.Gui.Workbench.SinceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:FileMergeAssistant.Gui.Workbench"
             xmlns:l="clr-namespace:FileMergeAssistant.Gui.Localization"
             xmlns:wb="clr-namespace:FileMergeAssistant.Workbench;assembly=FileMergeAssistant.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance w:SinceViewModel}">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <Grid Margin="40,32,40,56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520" MaxWidth="860" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Kicker}" Style="{StaticResource Small}" FontSize="13.5" />
        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,2,0,0" />
        <TextBlock Text="{l:T since.lead}" Style="{StaticResource Lead}" Margin="0,8,0,0" />
        <Border Background="{StaticResource StripBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                Visibility="{Binding DemoNote, Converter={StaticResource NullToVisibility}}">
          <TextBlock Text="{Binding DemoNote}" Style="{StaticResource Small}" />
        </Border>

        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" Margin="0,20,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type w:NoticeSection}">
              <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="20" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:NoticeViewModel}">
                      <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border x:Name="badge" Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"
                                  HorizontalAlignment="Left" TextElement.Foreground="{StaticResource AccentBrush}">
                            <Path x:Name="icon" Style="{StaticResource Icon}" Data="{StaticResource IconDrive}" HorizontalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,0" LineHeight="21" />
                            <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionButton}" ItemsPanel="{StaticResource WrapItems}"
                                          Focusable="False" Margin="0,10,0,0" Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource AccentDarkBrush}" Margin="0,10,0,0"
                                        Visibility="{Binding IsHandled, Converter={StaticResource BoolToVisibility}}">
                              <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Margin="0,0,6,0" />
                              <TextBlock Text="{Binding HandledText}" TextWrapping="Wrap" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsAmber}" Value="True">
                          <Setter TargetName="badge" Property="Background" Value="{StaticResource WarnSoftBrush}" />
                          <Setter TargetName="badge" Property="TextElement.Foreground" Value="{StaticResource WarnInkBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGrey}" Value="True">
                          <Setter TargetName="badge" Property="Background" Value="{StaticResource ChipBrush}" />
                          <Setter TargetName="badge" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:NoticeIcon.Copy}">
                          <Setter TargetName="icon" Property="Data" Value="{StaticResource IconCopy}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:NoticeIcon.Change}">
                          <Setter TargetName="icon" Property="Data" Value="{StaticResource IconChange}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:NoticeIcon.Ready}">
                          <Setter TargetName="icon" Property="Data" Value="{StaticResource IconCheck}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:NoticeIcon.Less}">
                          <Setter TargetName="icon" Property="Data" Value="{StaticResource IconMinus}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:NoticeIcon.More}">
                          <Setter TargetName="icon" Property="Data" Value="{StaticResource IconPlus}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:NoticeIcon.Recycle}">
                          <Setter TargetName="icon" Property="Data" Value="{StaticResource IconBin}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="{l:T since.back}" Style="{StaticResource PrimaryButton}" Command="{Binding GoToHubCommand}" />
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{Binding CountTitle}" Style="{StaticResource H2}" />
          <TextBlock Text="{Binding CountStart}" Style="{StaticResource Small}" Margin="0,2,0,8" />
          <ItemsControl ItemsSource="{Binding Deltas}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type wb:OpenStackDelta}">
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Delta, StringFormat={}{0:+0;−0;0}}" FontWeight="Bold" Margin="12,0,0,0" />
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:T since.keptAllNote}" Style="{StaticResource Faint}" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
