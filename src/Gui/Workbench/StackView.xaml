<UserControl x:Class="FileMergeAssistant.Gui.Workbench.StackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:FileMergeAssistant.Gui.Workbench"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance w:StackViewModel}">
  <UserControl.Resources>
    <!-- Background of a cell by its column: keeper, offline or normal; amber when the cell needs attention. -->
    <Style x:Key="CellBorder" TargetType="Border">
      <Setter Property="Width" Value="180" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderBrush" Value="{StaticResource RowDividerBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Column}" Value="{x:Static w:ColumnTone.Keeper}">
          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Column}" Value="{x:Static w:ColumnTone.Offline}">
          <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="SimpleCell" DataType="{x:Type w:SimpleCellViewModel}">
      <Border Style="{StaticResource CellBorder}">
        <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="DiffCell" DataType="{x:Type w:CellViewModel}">
      <Border x:Name="cell" Style="{StaticResource CellBorder}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="main" Text="{Binding Main}" />
          <TextBlock x:Name="sub" Text="{Binding Sub}" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                     Visibility="{Binding Sub, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:CellTone.Keeper}">
          <Setter TargetName="main" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:CellTone.KeeperMissing}">
          <Setter TargetName="main" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="main" Property="Foreground" Value="{StaticResource MutedBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:CellTone.Missing}">
          <Setter TargetName="main" Property="Foreground" Value="{StaticResource FaintBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:CellTone.Same}">
          <Setter TargetName="main" Property="Foreground" Value="{StaticResource MutedBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:CellTone.Older}">
          <Setter TargetName="main" Property="Foreground" Value="{StaticResource MutedBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:CellTone.Highlight}">
          <Setter TargetName="main" Property="Foreground" Value="{StaticResource WarnInkBrush}" />
          <Setter TargetName="main" Property="FontWeight" Value="Bold" />
          <Setter TargetName="sub" Property="Foreground" Value="{StaticResource WarnInkBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Highlighted}" Value="True">
          <Setter TargetName="cell" Property="Background" Value="{StaticResource WarnSoftBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Row">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="32,24,32,56">
      <!-- Toast after a decision -->
      <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,18"
              Visibility="{Binding Toast, Converter={StaticResource NullToVisibility}}" AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource AccentDarkBrush}">
          <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Toast}" FontWeight="SemiBold" Margin="0,0,12,0" />
          <TextBlock Text="還沒有改動任何檔案。" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Border>

      <!-- The stack changed under the user -->
      <Border Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="0,0,0,18"
              Visibility="{Binding Alert, Converter={StaticResource NullToVisibility}}" AutomationProperties.LiveSetting="Assertive">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="回工作台" Style="{StaticResource SmallButton}" Command="{Binding GoToHubCommand}" Margin="12,0,0,0" />
          <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Alert}" TextWrapping="Wrap" MaxWidth="1000" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Finished this run of decisions -->
      <Border Style="{StaticResource Card}" Padding="28,24" MaxWidth="760" HorizontalAlignment="Left"
              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="這一段整理完了" Style="{StaticResource H1}" />
          <TextBlock Text="{Binding DoneText}" Style="{StaticResource Lead}" Margin="0,8,0,14" />
          <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type w:SessionLogItem}">
                <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding What}" Style="{StaticResource Small}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,18,0,0">
            <Button Content="{Binding PendingLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding GoToPlanCommand}" Margin="0,0,12,0"
                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="回工作台，繼續下一疊" Style="{StaticResource SecondaryButton}" Command="{Binding GoToHubCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Grid Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="480" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- Heading -->
        <DockPanel Grid.ColumnSpan="3">
          <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="24,4,0,0">
            <TextBlock Text="{Binding Position}" Style="{StaticResource Small}" HorizontalAlignment="Right" />
            <TextBlock Text="決定之後會自動換下一疊" Style="{StaticResource Faint}" HorizontalAlignment="Right" />
          </StackPanel>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Content="工作台" Style="{StaticResource LinkButton}" Command="{Binding GoToHubCommand}" />
              <TextBlock Text=" / " Foreground="{StaticResource FaintBrush}" />
              <TextBlock Text="{Binding Group}" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding KindLine}" Style="{StaticResource Small}" FontSize="13.5" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Why}" Style="{StaticResource Lead}" Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left" />
            <Expander Header="判定依據" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left">
              <TextBlock Text="{Binding Evidence}" Style="{StaticResource Small}" FontSize="13.5" MaxWidth="820" Margin="22,4,0,0" />
            </Expander>
          </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
          <Border Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,8" Margin="0,0,0,8"
                  Visibility="{Binding BlockedStackText, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}">
              <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding BlockedStackText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Background="{StaticResource StripBrush}" CornerRadius="6" Padding="14,8"
                  Visibility="{Binding RemovedText, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="放回這疊" Style="{StaticResource SmallButton}" Command="{Binding RestoreRemovedCommand}" Margin="12,0,0,0" />
              <TextBlock Text="{Binding RemovedText}" Style="{StaticResource Body}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- Comparison -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,18,0,0">
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="逐份對照" Style="{StaticResource H2}" FontSize="20" Margin="0,0,14,0" />
            <TextBlock Text="以正本為比較基準；換一份當正本，比較結果會跟著變。" Style="{StaticResource Small}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
          </DockPanel>
          <Border Style="{StaticResource Card}" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel Width="{Binding TableWidth}" HorizontalAlignment="Left" AutomationProperties.Name="各份複本的差異">
                <!-- Column headers -->
                <StackPanel Orientation="Horizontal">
                  <Border Width="230" Padding="14,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Bottom">
                      <TextBlock Text="檔案" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DiffNote}" Style="{StaticResource Small}" />
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Columns}" ItemsPanel="{StaticResource Row}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type w:StackColumnViewModel}">
                        <Border x:Name="head" Width="180" Padding="12,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,1"
                                Background="{StaticResource SurfaceBrush}" TextElement.Foreground="{StaticResource InkBrush}">
                          <StackPanel>
                            <Border x:Name="pill" CornerRadius="10" Padding="8,1,8,2" HorizontalAlignment="Left" Background="{StaticResource ChipBrush}" Margin="0,0,0,8">
                              <TextBlock x:Name="pillText" Text="{Binding Pill}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Source}" FontWeight="Bold" FontSize="15" />
                              <Path x:Name="lock" Style="{StaticResource Icon}" Data="{StaticResource IconLock}" Margin="6,0,0,0" ToolTip="受保護"
                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0">
                              <Run x:Name="prefix" Text="{Binding Prefix, Mode=OneWay}" Foreground="{StaticResource FaintBrush}" /><Run Text="{Binding Tail, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <ItemsControl x:Name="metas" ItemsSource="{Binding Metas}" Margin="0,6,0,0" Focusable="False" TextElement.Foreground="{StaticResource MutedBrush}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,2" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="keeperNote" Text="{Binding KeeperNote}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding KeeperNote, Converter={StaticResource NullToVisibility}}" />
                            <Button Content="設為正本" Style="{StaticResource SmallButton}" Command="{Binding SetKeeper}" Margin="0,10,0,0"
                                    AutomationProperties.Name="{Binding SetKeeperName}" Visibility="{Binding CanSetKeeper, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="離線，不能設為正本" Style="{StaticResource Faint}" Margin="0,10,0,0"
                                       Visibility="{Binding OfflineNoKeeper, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsAlsoKept}" Margin="0,10,0,0"
                                      Visibility="{Binding ShowAlsoKeep, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="也保留這份" FontSize="13" />
                            </CheckBox>
                            <Button Content="不屬於這疊" Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding Remove}" Margin="0,10,0,0"
                                    AutomationProperties.Name="{Binding RemoveName}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:ColumnTone.Keeper}">
                            <Setter TargetName="head" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="head" Property="TextElement.Foreground" Value="White" />
                            <Setter TargetName="pill" Property="Background" Value="White" />
                            <Setter TargetName="pillText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="prefix" Property="Foreground" Value="{StaticResource AccentOnDarkBrush}" />
                            <Setter TargetName="metas" Property="TextElement.Foreground" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="keeperNote" Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:ColumnTone.Offline}">
                            <Setter TargetName="head" Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
                            <Setter TargetName="pill" Property="Background" Value="{StaticResource OfflineBrush}" />
                            <Setter TargetName="pillText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Pill}" Value="移入回收區">
                            <Setter TargetName="pill" Property="Background" Value="{StaticResource ChipBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Pill}" Value="也保留">
                            <Setter TargetName="pill" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="pillText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Pill}" Value="受保護，保留">
                            <Setter TargetName="pill" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="pillText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Identical files -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSame, Converter={StaticResource BoolToVisibility}}">
                  <Border Width="230" Padding="14,9" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                      <TextBlock Text="{Binding SameLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SameSub}" Style="{StaticResource Small}" />
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding SameCells}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource SimpleCell}" Focusable="False" />
                </StackPanel>

                <!-- Differences -->
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type w:StackRowViewModel}">
                      <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="230" Padding="14,9">
                            <StackPanel>
                              <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                              <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}" Margin="0,4,0,0"
                                          Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,4,0" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Warning}" FontSize="12.5" TextWrapping="Wrap" Width="180" />
                              </StackPanel>
                              <TextBlock x:Name="hint" Text="{Binding Hint}" FontSize="12.5" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                         Visibility="{Binding Hint, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource DiffCell}" Focusable="False" />
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HintIsWarning}" Value="True">
                          <Setter TargetName="hint" Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="14,10"
                        Visibility="{Binding NoDiff, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="沒有不同的地方。" Foreground="{StaticResource MutedBrush}" />
                </Border>

                <!-- Regenerable folders -->
                <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Visibility="{Binding HasRegenerable, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="230" Padding="14,9">
                      <StackPanel>
                        <TextBlock Text="{Binding RegenerableLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RegenerableSub}" Style="{StaticResource Small}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding RegenerableCells}" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource SimpleCell}" Focusable="False" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Background="{StaticResource StripBrush}" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                  Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Note}" Style="{StaticResource Body}" LineHeight="21" />
          </Border>
        </StackPanel>

        <!-- Decision -->
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,18,0,0">
          <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
              <TextBlock Text="怎麼處理這疊" Style="{StaticResource H2}" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type w:ActionOptionViewModel}">
                    <RadioButton Style="{StaticResource ChoiceCard}" GroupName="action" IsChecked="{Binding IsSelected}" Margin="0,0,0,8"
                                 AutomationProperties.Name="{Binding Label}">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <Border CornerRadius="4" Background="{StaticResource AccentBrush}" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="建議" FontSize="11.5" Foreground="White" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" FontSize="13" Margin="0,2,0,0" />
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0" BorderBrush="{StaticResource WarnBorderBrush}"
                  Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="要選版本的檔" Style="{StaticResource H2}" />
              <TextBlock Text="不會自動合併檔案內容；只能選一版，或兩份都留。" Style="{StaticResource Small}" Margin="0,2,0,8" />
              <ItemsControl ItemsSource="{Binding Conflicts}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type w:ConflictViewModel}">
                    <StackPanel Margin="0,4,0,8">
                      <TextBlock Text="{Binding Path}" FontWeight="Bold" />
                      <TextBlock Text="{Binding Compare}" Style="{StaticResource Small}" Margin="0,2,0,6" />
                      <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type w:ConflictOptionViewModel}">
                            <RadioButton Style="{StaticResource Radio}" GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" Margin="0,4"
                                         AutomationProperties.Name="{Binding Label}">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13.5" />
                                <TextBlock Text="{Binding Why}" Style="{StaticResource Faint}" Visibility="{Binding Why, Converter={StaticResource NullToVisibility}}" />
                              </StackPanel>
                            </RadioButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="加入後，執行時會做的事" Style="{StaticResource H2}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Outcome}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type w:OutcomeViewModel}">
                    <Grid Margin="0,0,0,8" x:Name="line" TextElement.Foreground="{StaticResource InkBrush}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Path x:Name="icon" Style="{StaticResource Icon}" Data="{StaticResource IconDash}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" Foreground="{Binding (TextElement.Foreground), ElementName=line}" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:OutcomeIcon.Copy}">
                        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconCopy}" />
                        <Setter TargetName="icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:OutcomeIcon.Recycle}">
                        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconBin}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:OutcomeIcon.Keep}">
                        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconCheck}" />
                        <Setter TargetName="icon" Property="Stroke" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:OutcomeIcon.Offline}">
                        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconOffline}" />
                        <Setter TargetName="line" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Static w:OutcomeIcon.Warn}">
                        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconWarn}" />
                        <Setter TargetName="line" Property="TextElement.Foreground" Value="{StaticResource WarnInkBrush}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="{StaticResource StripBrush}" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding Space}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Style="{StaticResource Small}" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

          <Button Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}" MinHeight="48" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                  Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" />
          <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}" Margin="0,8,0,0"
                      Visibility="{Binding BlockReason, Converter={StaticResource NullToVisibility}}">
            <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,6,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding BlockReason}" TextWrapping="Wrap" Width="320" FontSize="13.5" />
          </StackPanel>
          <TextBlock Text="{Binding PrimaryNote}" Style="{StaticResource Small}" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
