<UserControl x:Class="FileMergeAssistant.Gui.Workbench.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:FileMergeAssistant.Gui.Workbench"
             xmlns:l="clr-namespace:FileMergeAssistant.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance w:HubViewModel}">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <Grid Margin="40,32,40,56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{l:T hub.title}" Style="{StaticResource H1}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Foreground="{StaticResource Ink2Brush}" Margin="0,6,0,0" />

        <!-- Since the last visit -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12" BorderBrush="{StaticResource AccentBrush}"
                Visibility="{Binding HasSince, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:T hub.since.open}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSinceCommand}" Margin="12,0,0,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding SinceTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SinceNote}" Style="{StaticResource Small}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Suggested next stack -->
        <ContentControl Content="{Binding Featured}" Focusable="False" Margin="0,20,0,0">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="{x:Type w:FeaturedStackViewModel}">
              <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                <StackPanel>
                  <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7,7,0,0" Padding="20,10">
                    <WrapPanel>
                      <TextBlock Text="{l:T hub.featured.title}" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" Margin="0,0,14,0" />
                      <TextBlock Text="{Binding Reason}" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap" />
                    </WrapPanel>
                  </Border>
                  <Grid Margin="20,16,20,18">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <w:StackGlyph Count="{Binding CopyCount}" IsLarge="True" VerticalAlignment="Top" Margin="0,4,18,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="22" />
                      <TextBlock Text="{Binding Kind}" Style="{StaticResource Small}" Margin="0,2,0,8" />
                      <ItemsControl ItemsSource="{Binding Places}" ItemsPanel="{StaticResource WrapItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type w:PlaceChip}">
                            <Grid Margin="0,0,6,6">
                              <Border x:Name="chip" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}" Padding="8,2">
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                              </Border>
                              <Rectangle x:Name="dash" RadiusX="4" RadiusY="4" Stroke="{StaticResource HintBrush}" StrokeDashArray="3 2" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource OfflineBrush}" />
                                <Setter TargetName="chip" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" Foreground="{StaticResource Ink2Brush}" Margin="0,6,0,0" LineHeight="22" />
                      <WrapPanel Margin="0,16,0,0">
                        <Button Content="{l:T hub.featured.start}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                                Command="{Binding DataContext.OpenFeaturedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="{l:T hub.featured.skip}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DataContext.SkipFeaturedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- The list -->
        <DockPanel Margin="0,30,0,10">
          <TextBlock DockPanel.Dock="Right" Text="{Binding ListNote}" Style="{StaticResource Small}" VerticalAlignment="Bottom" />
          <TextBlock Text="{l:T hub.list.title}" Style="{StaticResource H2}" FontSize="20" />
        </DockPanel>
        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="14,8" Margin="0,0,0,12"
                Visibility="{Binding PairNote, Converter={StaticResource NullToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:T hub.list.clearFilter}" Style="{StaticResource LinkButton}" Command="{Binding ClearPairCommand}" />
            <TextBlock Text="{Binding PairNote}" Foreground="{StaticResource AccentDarkBrush}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type w:HubGroupViewModel}">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <DockPanel Margin="18,12">
                    <Button DockPanel.Dock="Right" Content="{Binding BulkLabel}" Style="{StaticResource SmallButton}" Command="{Binding ToggleBulkCommand}"
                            Visibility="{Binding HasBulk, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" />
                    </StackPanel>
                  </DockPanel>
                  <Border Background="{StaticResource StripBrush}" Padding="18,12" Visibility="{Binding IsBulkOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <TextBlock Text="{Binding BulkText}" Style="{StaticResource Body}" />
                      <WrapPanel Margin="0,10,0,0">
                        <Button Content="{Binding BulkGo}" Style="{StaticResource PrimaryButton}" MinHeight="38" Command="{Binding Bulk}" Margin="0,0,10,0" />
                        <Button Content="{l:T hub.bulk.cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleBulkCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type w:HubItemViewModel}">
                        <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="18,11">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="40" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <w:StackGlyph Count="{Binding CopyCount}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                              <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="　" /><Run Text="{Binding Kind, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                              </TextBlock>
                              <TextBlock Text="{Binding Where}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" Foreground="{StaticResource Ink2Brush}" Margin="0,2,0,0" />
                              <StackPanel Orientation="Horizontal" Margin="0,4,0,0" TextElement.Foreground="{StaticResource MutedBrush}"
                                          Visibility="{Binding BlockedText, Converter={StaticResource NullToVisibility}}">
                                <Path x:Name="blockIcon" Style="{StaticResource Icon}" Data="{StaticResource IconSync}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding BlockedText}" FontSize="12.5" TextWrapping="Wrap" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Size}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button x:Name="open" Grid.Column="3" Content="{Binding OpenLabel}" Command="{Binding Open}" Style="{StaticResource PrimaryButton}"
                                    MinHeight="36" Padding="16,0" HorizontalAlignment="Right" AutomationProperties.Name="{Binding OpenName}" />
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsOfflineBlock}" Value="True">
                            <Setter TargetName="blockIcon" Property="Data" Value="{StaticResource IconOffline}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsReady}" Value="False">
                            <Setter TargetName="open" Property="Style" Value="{StaticResource SecondaryButton}" />
                            <Setter TargetName="open" Property="MinHeight" Value="36" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Margin="0,4,0,0" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
          <Button Content="{Binding LoadMoreLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding LoadMoreCommand}" Margin="0,0,14,0" />
          <TextBlock Text="{l:T hub.list.loadMoreNote}" Style="{StaticResource Small}" VerticalAlignment="Center" />
        </WrapPanel>
      </StackPanel>

      <!-- Side panel -->
      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}" Padding="18,14">
          <StackPanel>
            <TextBlock Text="{l:T hub.tray.title}" Style="{StaticResource H2}" />
            <TextBlock Text="{l:T hub.tray.empty}" Style="{StaticResource Small}" FontSize="13.5" Margin="0,6,0,0"
                       Visibility="{Binding HasTray, Converter={StaticResource InverseBoolToVisibility}}" />
            <StackPanel Visibility="{Binding HasTray, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding Tray}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type w:TrayItem}">
                    <StackPanel Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{l:T hub.tray.unchanged}" Style="{StaticResource Small}" Margin="0,0,0,10" />
              <Button Content="{Binding TrayActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="38" Command="{Binding OpenPlanCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="{l:T hub.pairs.title}" Style="{StaticResource H2}" />
            <TextBlock Text="{l:T hub.pairs.hint}" Style="{StaticResource Small}" Margin="0,2,0,10" />
            <ItemsControl ItemsSource="{Binding Pairs}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type w:PairFilterViewModel}">
                  <ToggleButton Style="{StaticResource FilterToggle}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Pick}" Margin="0,0,0,2"
                                AutomationProperties.Name="{Binding Label}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="28" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{StaticResource ChipBrush}" VerticalAlignment="Center" Margin="6,0">
                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource HintBrush}" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" />
                    </Grid>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PairsNote}" Style="{StaticResource Faint}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="{l:T hub.kind.title}" Style="{StaticResource H2}" Margin="0,0,0,8" />
            <RadioButton Content="{l:T hub.kind.all}" Style="{StaticResource Radio}" GroupName="kind" IsChecked="{Binding IsAllKinds}" Margin="0,4" />
            <RadioButton Content="{l:T hub.kind.folder}" Style="{StaticResource Radio}" GroupName="kind" IsChecked="{Binding IsFolderKind}" Margin="0,4" />
            <RadioButton Content="{l:T hub.kind.file}" Style="{StaticResource Radio}" GroupName="kind" IsChecked="{Binding IsFileKind}" Margin="0,4" />
            <RadioButton Style="{StaticResource Radio}" GroupName="kind" IsEnabled="False" Margin="0,4">
              <StackPanel>
                <TextBlock Text="{l:T hub.kind.photos}" />
                <TextBlock Text="{l:T hub.kind.later}" Style="{StaticResource Faint}" />
              </StackPanel>
            </RadioButton>
            <TextBlock Text="{l:T hub.sort.title}" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,14,0,4" />
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" MinHeight="34" Padding="8,6"
                      AutomationProperties.Name="{l:T hub.sort.title}" />
            <TextBlock Text="{l:T hub.sort.note}" Style="{StaticResource Faint}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
