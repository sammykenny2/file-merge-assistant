<UserControl x:Class="FileWorkbench.Gui.Workbench.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:FileWorkbench.Gui.Workbench"
             xmlns:l="clr-namespace:FileWorkbench.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance w:HistoryViewModel}">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <Grid Margin="40,32,40,56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <StackPanel Visibility="{Binding HasBatch, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{l:T history.empty.title}" Style="{StaticResource H1}" />
          <TextBlock Text="{l:T history.empty.lead}" Style="{StaticResource Lead}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding HasBatch, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding Kicker}" Style="{StaticResource Small}" FontSize="13.5" />
          <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Lead}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />

          <ItemsControl ItemsSource="{Binding SpaceFigures}" Margin="0,16,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type w:SpaceFigure}">
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,0">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" />
                    <TextBlock x:Name="value" Text="{Binding Value}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Faint}" />
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsAccent}" Value="True">
                    <Setter TargetName="value" Property="Foreground" Value="{StaticResource AccentBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Failures -->
          <Border Margin="0,18,0,0" Padding="16,12" CornerRadius="8" Background="{StaticResource WarnPaleBrush}" BorderBrush="{StaticResource WarnBorderBrush}" BorderThickness="1"
                  Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WarnInkBrush}">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarn}" Margin="0,0,8,0" />
                <TextBlock Text="{l:T history.failures.title}" FontWeight="Bold" FontSize="16" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Failures}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type w:FailureViewModel}">
                    <StackPanel Margin="0,4">
                      <TextBlock TextWrapping="Wrap"><Run Text="{Binding Verb, Mode=OneWay}" FontWeight="Bold" /><Run Text="{l:T history.failures.separator}" /><Run Text="{Binding Target, Mode=OneWay}" /></TextBlock>
                      <TextBlock Text="{Binding Reason}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel Margin="0,10,0,0">
                <Button Content="{Binding RetryLabel}" Style="{StaticResource PrimaryButton}" MinHeight="38" Command="{Binding RetryCommand}"
                        IsEnabled="{Binding IsRetrying, Converter={StaticResource InverseBool}}" Margin="0,0,12,0" />
                <TextBlock Text="{l:T history.failures.retryHint}" Style="{StaticResource Small}" VerticalAlignment="Center" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Skipped -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12" Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Skipped}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type w:SkippedViewModel}">
                  <StackPanel Margin="0,2,0,6">
                    <TextBlock Text="{l:T history.skipped.title}" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" Margin="0,4,0,8" />
                    <Button Content="{l:T history.skipped.compare}" Style="{StaticResource SmallButton}" Command="{Binding Open}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- Every item -->
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <DockPanel Margin="18,12">
                <Button DockPanel.Dock="Right" Content="{l:T history.items.restoreAllAsk}" Style="{StaticResource SmallButton}" Command="{Binding AskRestoreAllCommand}"
                        IsEnabled="{Binding CanRestoreAll}" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{l:T history.items.title}" Style="{StaticResource H2}" />
                  <TextBlock Text="{l:T history.items.restoreAllHint}" Style="{StaticResource Small}" />
                </StackPanel>
              </DockPanel>
              <Border Background="{StaticResource StripBrush}" Padding="18,12" Visibility="{Binding IsConfirmingRestoreAll, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="{l:T history.items.restoreAllConfirm}" Style="{StaticResource Body}" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="{l:T history.items.restoreAll}" Style="{StaticResource PrimaryButton}" MinHeight="38" Command="{Binding RestoreAllCommand}" Margin="0,0,10,0" />
                    <Button Content="{l:T history.cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelRestoreAllCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type w:BatchItemViewModel}">
                    <Border BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="18,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{Binding Status}" Focusable="False" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBlock TextWrapping="Wrap"><Run Text="{Binding Verb, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding Gap, Source={x:Static l:Loc.Instance}, Mode=OneWay}" /><Run Text="{Binding Target, Mode=OneWay}" /></TextBlock>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{l:T history.item.restore}" Style="{StaticResource SmallButton}" Command="{Binding Restore}" VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding RestoreName}" Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Restore conflicts -->
        <ItemsControl ItemsSource="{Binding Conflicts}" Focusable="False" Margin="0,16,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type w:RestoreConflictViewModel}">
              <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarnBorderBrush}" Padding="18,14" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="{Binding Kicker}" Style="{StaticResource Small}" />
                  <TextBlock Text="{l:T history.conflict.title}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding Path}" FontWeight="SemiBold" Margin="0,6,0,8" TextWrapping="Wrap" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T history.conflict.recycledLabel}" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Column="1" Text="{Binding Recycled}" Style="{StaticResource Body}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="{l:T history.conflict.currentLabel}" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Current}" Style="{StaticResource Body}" Margin="0,2" />
                  </Grid>
                  <StackPanel Visibility="{Binding IsResolved, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{l:T history.conflict.prompt}" Style="{StaticResource Body}" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type w:RestoreChoiceViewModel}">
                          <RadioButton Style="{StaticResource Radio}" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,4"
                                       GroupName="{Binding DataContext.GroupName, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" MinHeight="38" Margin="0,10,0,0"
                            Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource AccentDarkBrush}" Margin="0,10,0,0"
                              Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Resolution}" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}" Padding="0,14,0,6">
          <StackPanel>
            <TextBlock Text="{l:T history.batches.title}" Style="{StaticResource H2}" Margin="18,0,18,8" />
            <ItemsControl ItemsSource="{Binding Batches}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type w:BatchSummaryViewModel}">
                  <Button Command="{Binding Select}" Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Foreground="{StaticResource InkBrush}">
                    <Border x:Name="row" Padding="15,9,18,9" BorderThickness="3,0,0,0" BorderBrush="Transparent" Background="Transparent">
                      <StackPanel>
                        <TextBlock><Run Text="{Binding When, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Gap, Source={x:Static l:Loc.Instance}, Mode=OneWay}" /><Run x:Name="state" Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource AccentDarkBrush}" /></TextBlock>
                        <TextBlock Text="{Binding Counts}" Style="{StaticResource Small}" />
                        <TextBlock Text="{Binding Restore}" Style="{StaticResource Faint}" />
                      </StackPanel>
                    </Border>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                      <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                      <Setter TargetName="state" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                      <Setter TargetName="state" Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="{l:T history.recycle.title}" Style="{StaticResource H2}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Areas}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type w:RecycleAreaRow}">
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Bytes, Converter={StaticResource BytesText}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:T history.recycle.note}" Style="{StaticResource Small}" Margin="0,8,0,10" />
            <Button Content="{l:T history.recycle.emptyAsk}" Style="{StaticResource SecondaryButton}" Command="{Binding AskEmptyCommand}" IsEnabled="{Binding CanEmpty}" />
            <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                    Visibility="{Binding IsConfirmingEmpty, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnInkBrush}">
                  <Run Text="{Binding EmptyWarningBefore, Mode=OneWay}" /><Run Text="{Binding RecycleTotal, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding EmptyWarningAfter, Mode=OneWay}" />
                </TextBlock>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="{l:T history.recycle.empty}" Style="{StaticResource PrimaryButton}" MinHeight="36" Command="{Binding EmptyCommand}" Margin="0,0,10,0" />
                  <Button Content="{l:T history.cancel}" Style="{StaticResource SecondaryButton}" MinHeight="36" Command="{Binding CancelEmptyCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
