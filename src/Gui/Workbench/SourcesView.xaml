<UserControl x:Class="FileMergeAssistant.Gui.Workbench.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:FileMergeAssistant.Gui.Workbench"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance w:SourcesViewModel}">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <Grid Margin="40,32,40,56">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*" MinWidth="460" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="*" MinWidth="380" MaxWidth="600" />
      </Grid.ColumnDefinitions>

      <!-- Sources -->
      <StackPanel Grid.Column="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
            <Button Content="加入資料夾" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding AddFoldersCommand}" />
            <TextBlock Text="掃描中也可以加入，會排在佇列最後" Style="{StaticResource Faint}" Margin="0,6,0,0" HorizontalAlignment="Right" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="來源" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Foreground="{StaticResource Ink2Brush}" Margin="0,6,24,0" />
          </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Sources}" Margin="0,22,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type w:SourceCardViewModel}">
              <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Content="{Binding ScanLabel}" Command="{Binding Scan}" IsEnabled="{Binding ScanEnabled}" Style="{StaticResource SmallButton}" Margin="0,0,8,0" />
                      <Button Content="設定" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource SmallButton}" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,0,10,0" VerticalAlignment="Center" />
                      <ContentControl Content="{Binding Status}" Focusable="False" Margin="0,0,8,0" />
                      <ContentControl Content="{Binding ProtectedChip}" Focusable="False" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PathText}" Margin="0,6,0,0">
                    <Run Text="{Binding Prefix, Mode=OneWay}" Foreground="{StaticResource FaintBrush}" /><Run Text="{Binding Tail, Mode=OneWay}" FontWeight="SemiBold" />
                  </TextBlock>
                  <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Indexed}" Style="{StaticResource Small}" Margin="0,0,18,2" />
                    <TextBlock Text="{Binding When}" Style="{StaticResource Small}" Margin="0,0,18,2" />
                    <TextBlock Text="{Binding Disk}" Style="{StaticResource Small}" Margin="0,0,18,2" />
                  </WrapPanel>
                  <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6" Background="{StaticResource OfflineBrush}"
                          Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="指定新位置…" Style="{StaticResource SmallButton}" VerticalAlignment="Top" Margin="12,0,0,0"
                              ToolTip="資料夾被搬走時使用：會先比對結構，給你看摘要，接受後才更新來源。" />
                      <TextBlock Text="{Binding OfflineNote}" Style="{StaticResource Small}" />
                    </DockPanel>
                  </Border>
                  <Grid Margin="0,12,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.ColumnSpan="2" Grid.RowSpan="4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" />
                    <TextBlock Grid.Row="0" Text="可重建，只記大小" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Regenerable}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="0,10,0,4" />
                    <TextBlock Grid.Row="1" Text="排除" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Exclusions}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="受保護" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="0,4">
                      <TextBlock.Text>
                        <Binding Path="IsProtected">
                          <Binding.Converter>
                            <w:BoolTextConverter TrueText="不會被移入回收區或覆寫；合併時可以新增檔案進來。" FalseText="沒有。可以在這裡設為受保護。" />
                          </Binding.Converter>
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Text="從清單移除" Style="{StaticResource Small}" FontWeight="SemiBold" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="只會停止追蹤，不會刪除資料夾裡的檔案。可以選擇保留或清除這個來源的索引；操作歷史不受影響。"
                               Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="0,4" />
                  </Grid>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                  <Setter TargetName="card" Property="Background" Value="#F7F8F9" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Scan jobs -->
      <StackPanel Grid.Column="2">
        <TextBlock Text="掃描工作" Style="{StaticResource H2}" FontSize="20" />
        <TextBlock Text="一次執行一個，其餘排隊。掃描時可以照常在工作台整理已經找到的疊。" Style="{StaticResource Small}" FontSize="13.5" Margin="0,4,0,14" />

        <ContentControl Content="{Binding Running}" Focusable="False">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="{x:Type w:RunningJobViewModel}">
              <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" Padding="18,14" Margin="0,0,0,20">
                <StackPanel>
                  <WrapPanel>
                    <ContentControl Content="{Binding State}" Focusable="False" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                  </WrapPanel>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="92" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="1 探索" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Grid.Column="1" Text="{Binding Discover}" Style="{StaticResource Small}" FontSize="13.5" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Text="2 確認內容" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Confirm}" Style="{StaticResource Small}" FontSize="13.5" Foreground="{StaticResource AccentBrush}" />
                      <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,6,0,6" BorderThickness="0"
                                   Background="{StaticResource ChipBrush}" Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="確認內容的進度" />
                      <TextBlock Text="{Binding ConfirmNote}" Style="{StaticResource Faint}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="3 保存" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Save}" Style="{StaticResource Small}" FontSize="13.5" />
                  </Grid>
                  <TextBlock Text="{Binding Counts}" Style="{StaticResource Small}" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding Current}" Style="{StaticResource Faint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource StripBrush}"
                          Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{Binding PrimaryLabel}" Command="{Binding Primary}" IsEnabled="{Binding PrimaryEnabled}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="取消" Command="{Binding Cancel}" Style="{StaticResource SecondaryButton}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <StackPanel Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,20">
          <TextBlock Text="等候中" Style="{StaticResource H3}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Waiting}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type w:QueuedJobViewModel}">
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource IconButton}" Command="{Binding Up}" AutomationProperties.Name="{Binding UpLabel}" ToolTip="{Binding UpLabel}"
                              IsEnabled="{Binding IsFirst, Converter={StaticResource InverseBool}}" Margin="0,0,6,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconUp}" />
                      </Button>
                      <Button Style="{StaticResource IconButton}" Command="{Binding Down}" AutomationProperties.Name="{Binding DownLabel}" ToolTip="{Binding DownLabel}"
                              IsEnabled="{Binding IsLast, Converter={StaticResource InverseBool}}" Margin="0,0,6,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconDown}" />
                      </Button>
                      <Button Content="取消" Style="{StaticResource SmallButton}" Command="{Binding Cancel}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Position}" FontWeight="Bold" Foreground="{StaticResource FaintBrush}" Width="22" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,20">
          <TextBlock Text="需要你處理" Style="{StaticResource H3}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Attention}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type w:AttentionJobViewModel}">
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                  <StackPanel>
                    <WrapPanel>
                      <ContentControl Content="{Binding State}" Focusable="False" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" FontSize="13.5" Margin="0,8,0,10" />
                    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionButton}" ItemsPanel="{StaticResource WrapItems}" Focusable="False" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Visibility="{Binding HasFinished, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,20">
          <TextBlock Text="最近完成" Style="{StaticResource H3}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Finished}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type w:FinishedJobViewModel}">
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                  <StackPanel>
                    <WrapPanel>
                      <ContentControl Content="{Binding State}" Focusable="False" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBlock Text="{Binding When}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Counts}" Style="{StaticResource Small}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Small}" FontSize="13.5" Foreground="{StaticResource InkBrush}" Margin="0,6,0,0"
                               Visibility="{Binding ShowErrors, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                      <Button Content="{Binding ErrorsLabel}" Command="{Binding ToggleErrorsCommand}" Style="{StaticResource SmallButton}" Margin="0,0,8,0" />
                      <Button Content="重新掃描失敗的項目" Command="{Binding Rescan}" Style="{StaticResource SmallButton}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Button Content="{Binding HubLinkLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding GoToHubCommand}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
