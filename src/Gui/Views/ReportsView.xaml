<UserControl x:Class="FileMergeAssistant.Gui.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileMergeAssistant.Gui.Converters"
             xmlns:vm="clr-namespace:FileMergeAssistant.Gui.ViewModels"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
  <UserControl.Resources>
    <conv:InverseBooleanConverter x:Key="InverseBool" />
  </UserControl.Resources>

  <StackPanel MaxWidth="400">
    <TextBlock Text="Export Reports" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

    <TextBlock Text="Report Format" FontWeight="SemiBold" Margin="0,0,0,4" />
    <ComboBox ItemsSource="{Binding Formats}"
              SelectedItem="{Binding SelectedFormat}"
              IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}"
              Padding="6,4"
              Margin="0,0,0,20"
              Width="200"
              HorizontalAlignment="Left" />

    <Button Content="Export Report"
            Style="{StaticResource PrimaryButtonStyle}"
            Command="{Binding ExportReportCommand}"
            HorizontalAlignment="Left"
            Margin="0,0,0,20" />

    <TextBlock Text="{Binding StatusText}"
               Foreground="Gray"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
