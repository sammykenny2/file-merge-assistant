<Application x:Class="FileMergeAssistant.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileMergeAssistant.Gui.ViewModels"
             xmlns:views="clr-namespace:FileMergeAssistant.Gui.Views">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type vm:ScanViewModel}">
        <views:ScanView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
        <views:ResultsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <views:ReportsView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
