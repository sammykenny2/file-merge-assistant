<UserControl x:Class="FileMergeAssistant.Gui.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FileMergeAssistant.Gui.ViewModels"
             xmlns:l="clr-namespace:FileMergeAssistant.Gui.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             Background="{StaticResource PageBrush}"
             FontFamily="{StaticResource UiFont}"
             FontSize="14"
             Foreground="{StaticResource InkBrush}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
  <DockPanel>
    <!-- Header: product mark, sections, demo badge, version -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="24,0">
        <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Foreground="{StaticResource InkBrush}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Hub}" AutomationProperties.Name="{l:T hub.title}" Margin="0,0,28,0">
          <StackPanel Orientation="Horizontal">
            <Canvas Width="22" Height="23" Margin="0,0,10,0" VerticalAlignment="Center">
              <Border Canvas.Left="7" Canvas.Top="0" Width="14" Height="17" BorderBrush="{StaticResource HintBrush}" BorderThickness="1.5" CornerRadius="2" Background="{StaticResource SurfaceBrush}" />
              <Border Canvas.Left="3.5" Canvas.Top="2.5" Width="14" Height="17" BorderBrush="{StaticResource HintBrush}" BorderThickness="1.5" CornerRadius="2" Background="{StaticResource SurfaceBrush}" />
              <Border Canvas.Left="0" Canvas.Top="5" Width="14" Height="17" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" CornerRadius="2" Background="{StaticResource AccentSoftBrush}" />
            </Canvas>
            <TextBlock Text="File Merge Assistant" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Chip}" BorderBrush="{StaticResource HintBrush}" CornerRadius="4" Margin="0,0,16,0"
                  Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="{l:T settings.distribution.demo}">
            <TextBlock Text="{l:T header.demo}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
          </Border>
          <Button Content="{l:T settings.title}" Style="{StaticResource NavTab}" Tag="{Binding IsSettingsSelected}"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Settings}"
                  Visibility="{Binding HasSettings, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <Button Content="{l:T hub.title}" Style="{StaticResource NavTab}" Tag="{Binding IsHubSelected}"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Hub}" />
          <Button Content="{l:T sources.title}" Style="{StaticResource NavTab}" Tag="{Binding IsSourcesSelected}"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Sources}" />
          <Button Style="{StaticResource NavTab}" Tag="{Binding IsPlanSelected}"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Plan}"
                  AutomationProperties.Name="{l:T header.nav.pending}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:T header.nav.pending}" VerticalAlignment="Center" />
              <Border MinWidth="22" Padding="6,0" Margin="6,0,0,0" CornerRadius="11" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource ChipBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPending}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding PendingCount}" FontSize="12.5" FontWeight="Normal" HorizontalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPending}" Value="True">
                          <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </StackPanel>
          </Button>
          <Button Content="{l:T header.nav.history}" Style="{StaticResource NavTab}" Tag="{Binding IsHistorySelected}"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.History}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Index status strip -->
    <Border DockPanel.Dock="Top" Background="{StaticResource StripBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="24,7">
      <ItemsControl ItemsSource="{Binding Strip}" Focusable="False" AutomationProperties.Name="{l:T header.strip.name}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:StripItem}">
            <StackPanel x:Name="item" Orientation="Horizontal" Margin="0,0,22,0" TextElement.Foreground="{StaticResource MutedBrush}">
              <Path x:Name="icon" Style="{StaticResource Icon}" Margin="0,0,5,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                </Path.RenderTransform>
              </Path>
              <TextBlock Text="{Binding Text}" FontSize="12.5" Foreground="{Binding (TextElement.Foreground), ElementName=item}" />
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StripTone.Busy}">
                <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                <Setter TargetName="icon" Property="Data" Value="{StaticResource IconSync}" />
                <Setter TargetName="item" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StripTone.Offline}">
                <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                <Setter TargetName="icon" Property="Data" Value="{StaticResource IconOffline}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
  </DockPanel>
</UserControl>
