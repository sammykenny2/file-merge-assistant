<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:w="clr-namespace:FileMergeAssistant.Gui.Workbench">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Theme.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Status chip: text plus an icon; the colour only repeats what the text says. -->
  <DataTemplate DataType="{x:Type w:ChipInfo}">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
      <Border x:Name="chip" CornerRadius="12" Padding="7,1,10,2" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
              Background="{StaticResource SurfaceBrush}" TextElement.Foreground="{StaticResource Ink2Brush}">
        <StackPanel Orientation="Horizontal">
          <Path x:Name="icon" Style="{StaticResource Icon}" Data="{StaticResource IconCheck}" Margin="0,0,4,0" Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
            </Path.RenderTransform>
          </Path>
          <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{Binding (TextElement.Foreground), ElementName=chip}" />
        </StackPanel>
      </Border>
      <Rectangle x:Name="dash" RadiusX="12" RadiusY="12" Stroke="{StaticResource HintBrush}" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Plain}">
        <Setter TargetName="chip" Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource ChipBrush}" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
        <Setter TargetName="chip" Property="Padding" Value="10,1,10,2" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Ok}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Busy}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconSync}" />
        <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Offline}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconOffline}" />
        <Setter TargetName="chip" Property="Background" Value="{StaticResource OfflineBrush}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="Transparent" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
        <Setter TargetName="dash" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Warn}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconWarn}" />
        <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnSoftBrush}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource WarnInkBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Wait}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconClock}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Paused}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconPause}" />
        <Setter TargetName="chip" Property="Background" Value="{StaticResource ChipBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Done}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource AccentDarkBrush}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Skipped}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconDash}" />
        <Setter TargetName="chip" Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource ChipBrush}" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static w:Tone.Protected}">
        <Setter TargetName="icon" Property="Visibility" Value="Visible" />
        <Setter TargetName="icon" Property="Data" Value="{StaticResource IconLock}" />
        <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter TargetName="chip" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Buttons for per-item actions -->
  <DataTemplate x:Key="ActionButton" DataType="{x:Type w:ActionInfo}">
    <Button x:Name="button" Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource SmallButton}" Margin="0,0,8,6" />
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsPrimary}" Value="True">
        <Setter TargetName="button" Property="Style" Value="{StaticResource PrimaryButton}" />
        <Setter TargetName="button" Property="MinHeight" Value="34" />
        <Setter TargetName="button" Property="Padding" Value="14,0" />
        <Setter TargetName="button" Property="FontSize" Value="13" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <ItemsPanelTemplate x:Key="WrapItems">
    <WrapPanel />
  </ItemsPanelTemplate>

</ResourceDictionary>
