<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:w="clr-namespace:FileWorkbench.Gui.Workbench"
                    xmlns:s="clr-namespace:FileWorkbench.Gui.Settings"
                    xmlns:conv="clr-namespace:FileWorkbench.Gui.Converters">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Styles.xaml" />
    <ResourceDictionary>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
      <conv:InverseBooleanConverter x:Key="InverseBool" />
      <w:BytesTextConverter x:Key="BytesText" />
    </ResourceDictionary>
    <ResourceDictionary Source="WorkbenchTemplates.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Workbench screens -->
  <DataTemplate DataType="{x:Type w:AddSourcesViewModel}">
    <w:AddSourcesView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:SourcesViewModel}">
    <w:SourcesView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:HubViewModel}">
    <w:HubView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:StackViewModel}">
    <w:StackView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:PlanViewModel}">
    <w:PlanView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:HistoryViewModel}">
    <w:HistoryView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:SinceViewModel}">
    <w:SinceView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type w:ImageReviewViewModel}">
    <w:ImageReviewView />
  </DataTemplate>
  <DataTemplate DataType="{x:Type s:SettingsViewModel}">
    <s:SettingsView />
  </DataTemplate>
</ResourceDictionary>
