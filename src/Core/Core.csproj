<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FileMergeAssistant</RootNamespace>
    <AssemblyName>FileMergeAssistant.Core</AssemblyName>
    <!-- LibraryImport (volume serial numbers) generates marshalling code that needs unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../analysis/Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- File hashing and comparison -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />

    <!-- Image perceptual hashing for photo deduplication -->
    <PackageReference Include="CoenM.ImageSharp.ImageHash" Version="1.3.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />

    <!-- Photo/video metadata extraction (EXIF, etc.) -->
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />

    <!-- Persistent index (ADR-008) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />

    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
